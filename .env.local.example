# Supabase (publik: aman di browser, dibatasi RLS)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server saja (JANGAN diawali NEXT_PUBLIC)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
FIRMS_MAP_KEY=

# Akun demo hanya-baca (tombol "Masuk sebagai demo"). Server saja, jangan diawali NEXT_PUBLIC.
DEMO_EMAIL=demo@apirimba.app
DEMO_PASSWORD=
# Garam untuk hash IP di pembatas laju (string acak bebas)
RATE_LIMIT_SALT=

# Peta dasar (opsional)
NEXT_PUBLIC_MAP_STYLE_DARK=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
NEXT_PUBLIC_MAP_STYLE_LIGHT=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json
